# luca-mcp client settings (all optional). The client keeps no secrets of its own: tokens issued by
# rai are stored in the OS keychain (file fallback under ~/.config/luca-mcp/, mode 0600).

# Luca server (ant-rai). Default: dev.
# LUCA_RAI_URL=https://dev-ms-rai-92624805037.us-central1.run.app
# Local rai dev server:
# LUCA_RAI_URL=http://localhost:3030

# Pre-registered public OAuth client id in rai (default luca-mcp).
# LUCA_MCP_CLIENT_ID=luca-mcp
# LUCA_MCP_TIMEOUT=60           # seconds per rai call
# LUCA_MCP_LOGIN_TIMEOUT=300    # seconds to wait for the browser login
# LUCA_MCP_CONFIG_DIR=~/.config/luca-mcp
# Credential store: auto (OS keychain, file fallback) or file (skip the keychain: CI, headless).
# LUCA_MCP_CREDENTIAL_STORE=auto
