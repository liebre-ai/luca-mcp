# Copy to .env for local development. Values here are placeholders; real secrets live in
# Secret Manager / Cloud Run env. See docs/plans/2026-09-08-luca-mcp-plan.md §5.

LUCA_MCP_ENV=dev
# Public base URL of THIS server (issuer for the tokens it mints; no trailing slash).
LUCA_MCP_BASE_URL=http://localhost:8080
LUCA_MCP_PORT=8080

# Liebre API this server calls on behalf of the user.
LIEBRE_API_BASE_URL=https://api-dev.liebre.ai/api/v1
LIEBRE_APP_BASE_URL=https://app-dev.liebre.ai

# Upstream identity provider (Auth0 in real environments; dev/mock_idp.py locally).
AUTH0_CONFIG_URL=http://localhost:9400/.well-known/openid-configuration
AUTH0_CLIENT_ID=luca-mcp-dev
AUTH0_CLIENT_SECRET=change-me
# Audience of the upstream access token = the Liebre API identifier in Auth0.
AUTH0_AUDIENCE=https://api-dev.liebre.ai/api/v1

# Keys: generate with `python -c "import secrets;print(secrets.token_urlsafe(48))"` and
# `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"`.
LUCA_MCP_JWT_SIGNING_KEY=change-me-32-bytes-minimum-random-string
LUCA_MCP_STORAGE_KEY=change-me-fernet-key

# Comma-separated redirect URI patterns MCP clients may register (loopback ports are flexible).
# LUCA_MCP_ALLOWED_REDIRECT_URIS=http://localhost:*,http://127.0.0.1:*,https://claude.ai/api/mcp/auth_callback

# Optional shared state store; when unset an in-memory store is used (single instance only).
# REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
